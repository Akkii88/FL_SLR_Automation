# ============================================================
# FL-SLR Automation - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenAlex API ---
# OpenAlex does not require an API key, but providing one
# gives higher rate limits. Get one at: https://openalex.org/api
OPENALEX_API_KEY=

# Optional: your email for OpenAlex polite pool (recommended)
OPENALEX_EMAIL=

# --- Database ---
# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///data/fl_slr.db

# --- Application ---
# Environment: development, testing, production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Search Defaults ---
# Default max candidates per search family
DEFAULT_MAX_CANDIDATES=500

# --- LLM (optional, for AI-assisted extraction/screening) ---
# Provider: openai, anthropic, or groq
LLM_PROVIDER=
LLM_API_KEY=
LLM_MODEL=
# Groq models: llama-3.3-70b-versatile, mixtral-8x7b-32768, etc.
# OpenAI models: gpt-4, gpt-4o, gpt-3.5-turbo
# Anthropic models: claude-sonnet-4-20250514, claude-haiku-4-20250514

# --- LLM Retry / Rate Limiting ---
# Max retry attempts for rate-limited requests (429)
LLM_MAX_RETRIES=5
# Initial backoff seconds (doubles each retry: 2, 4, 8, 16, 32)
LLM_INITIAL_BACKOFF_SECONDS=2.0
# Maximum backoff cap in seconds
LLM_MAX_BACKOFF_SECONDS=60.0
# Delay between consecutive LLM requests to pace TPM usage
LLM_REQUEST_DELAY_SECONDS=0.5
