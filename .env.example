# ============================================================
# FL-SLR Automation - Environment Configuration
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# --- OpenAlex API ---
# OpenAlex does not require an API key, but providing one
# gives higher rate limits. Get one at: https://openalex.org/api
OPENALEX_API_KEY=

# Optional: your email for OpenAlex polite pool (recommended)
OPENALEX_EMAIL=

# --- Database ---
# SQLite database file path (relative to project root)
DATABASE_URL=sqlite:///data/fl_slr.db

# --- Application ---
# Environment: development, testing, production
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000

# Logging level: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# --- Search Defaults ---
# Default max candidates per search family
DEFAULT_MAX_CANDIDATES=500

# --- Primary LLM Provider (Groq) ---
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b

# --- Groq Retry / Rate Limiting ---
GROQ_MAX_RETRIES=5
GROQ_INITIAL_BACKOFF_SECONDS=2.0
GROQ_MAX_BACKOFF_SECONDS=60.0
GROQ_REQUEST_DELAY_SECONDS=0.5

# --- Gemini Fallback Provider ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_PROJECT_NAME=
GEMINI_PROJECT_NUMBER=

# --- Gemini Retry / Rate Limiting ---
GEMINI_MAX_RETRIES=3
GEMINI_INITIAL_BACKOFF_SECONDS=1.0
GEMINI_MAX_BACKOFF_SECONDS=30.0
GEMINI_REQUEST_DELAY_SECONDS=0.3

# --- OpenRouter Fallback Provider (3rd) ---
# DISABLED by default because openai/gpt-oss-120b:free is unavailable.
# To enable: set OPENROUTER_ENABLED=true and update OPENROUTER_MODEL.
OPENROUTER_ENABLED=false
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-oss-120b
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
